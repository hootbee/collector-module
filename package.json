{
  "name": "stage-one-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "start:watch": "node --watch --require ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "auth:smoke": "ts-node src/scripts/auth-smoke.ts",
    "db:smoke": "ts-node src/scripts/db-smoke.ts",
    "data-sources:smoke": "ts-node src/scripts/data-sources-smoke.ts",
    "orchestrator:smoke": "ts-node src/scripts/orchestrator-smoke.ts",
    "pipeline:smoke": "ts-node src/scripts/pipeline-smoke.ts",
    "pipeline:crud:smoke": "ts-node src/scripts/pipeline-crud-smoke.ts",
    "module:integration:smoke": "ts-node src/scripts/module-integration-smoke.ts",
    "collection:smoke": "ts-node src/scripts/collection-smoke.ts",
    "collection:browser:smoke": "ts-node src/scripts/collection-browser-fallback-smoke.ts",
    "collection:download:smoke": "ts-node src/scripts/collection-download-smoke.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.8",
    "@nestjs/core": "^11.1.8",
    "@nestjs/platform-express": "^11.1.8",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.3.1",
    "papaparse": "^5.5.3",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/papaparse": "^5.3.16",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
