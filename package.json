{
  "name": "stage-one-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "start:watch": "node --watch --require ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "smoke": "ts-node src/scripts/smoke-test.ts",
    "collection:smoke": "ts-node src/scripts/collection-smoke.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.8",
    "@nestjs/core": "^11.1.8",
    "@nestjs/platform-express": "^11.1.8",
    "dotenv": "^17.3.1",
    "iconv-lite": "^0.7.0",
    "multer": "^2.0.2",
    "papaparse": "^5.5.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/multer": "^2.0.0",
    "@types/node": "^24.12.0",
    "@types/papaparse": "^5.3.16",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
