PORT=8787

# Provider: rule-based | openai | openai-compatible | vllm
LLM_PROVIDER=rule-based
# true 로 두면 원격 LLM 실패 시 rule-based fallback 허용, 기본은 즉시 실패
LLM_ALLOW_RULE_BASED_FALLBACK=false

# OpenAI
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5-mini
# OPENAI_TIMEOUT_MS=30000

# OpenAI-compatible / vLLM
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://210.117.143.180:12020
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_MODE=chat_completions
# LLM_TIMEOUT_MS=30000

# Discovery runtime
DISCOVERY_HTTP_TIMEOUT_MS=8000
DISCOVERY_CONNECTOR_LIMIT_PER_SOURCE=10
DISCOVERY_FETCHER_USER_AGENT=stage-one-backend/0.1

# Connector enable flags
DISCOVERY_ENABLE_SEED_CONNECTOR=true
DISCOVERY_ENABLE_HF_CONNECTOR=false
DISCOVERY_ENABLE_UCI_CONNECTOR=false
DISCOVERY_ENABLE_KAGGLE_CONNECTOR=false
DISCOVERY_ENABLE_SERPAPI_CONNECTOR=false
DISCOVERY_ENABLE_CROSSREF_CONNECTOR=false

# Hugging Face datasets
# Public search는 토큰 없이도 가능하지만 gated/private 접근 시 필요
HF_TOKEN=

# Kaggle datasets
# 새 CLI 기준 토큰 또는 legacy kaggle.json 사용 가능
KAGGLE_API_TOKEN=
KAGGLE_CONFIG_DIR=/absolute/path/to/backend/storage/kaggle
KAGGLE_CLI_PATH=/absolute/path/to/kaggle

# SerpAPI knowledge search
SERPAPI_API_KEY=

# Crossref knowledge search
# polite pool 식별용 메일 주소 권장
CROSSREF_MAILTO=
